{
  "root": "/home/step/certs/root_ca.crt",
  "crt": "/home/step/certs/intermediate_ca.crt",
  "key": "/home/step/secrets/intermediate_ca.key",
  "address": ":9000",
  "dnsNames": [
    "ca.client.internal",
    "10.88.0.1"
  ],
  "logger": {
    "format": "json"
  },
  "db": {
    "type": "badgerv2",
    "dataSource": "/home/step/db"
  },
  "authority": {
    "enableAdmin": false,
    "claims": {
      "minTLSCertDuration": "1h",
      "defaultTLSCertDuration": "168h",
      "maxTLSCertDuration": "168h",
      "disableRenewal": true
    },
    "policy": {
      "x509": {
        "allow": {
          "dns": [
            "app.node01.client.internal"
          ]
        },
        "allowWildcardNames": false
      }
    },
    "provisioners": [
      {
        "type": "ACME",
        "name": "internal",
        "challenges": [
          "tls-alpn-01"
        ],
        "options": {
          "x509": {
            "templateFile": "/home/step/config/server.tpl"
          }
        }
      }
    ]
  },
  "tls": {
    "minVersion": 1.2,
    "maxVersion": 1.3,
    "renegotiation": false
  }
}
